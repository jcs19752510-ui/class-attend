# 실제 값은 .env에 넣고 커밋하지 마세요 (.gitignore에 이미 .env 포함 여부 확인)
DATABASE_URL="postgresql://att:att@localhost:5432/att_dev"
JWT_SECRET="개발용 예시 값 — 운영 배포 전 반드시 교체"
# U6 개인정보 파기 배치의 Vercel Cron 인증용 (harness_09_deployment_runbook.md 참고)
CRON_SECRET="개발용 예시 값 — 운영 배포 전 반드시 무작위 문자열로 교체"
# 최초 franchise_admin 부트스트랩 계정 (prisma/seed.ts, `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@class-attend.local"
SEED_ADMIN_PASSWORD="운영 DB에 시딩할 때는 반드시 강력한 값으로 교체"
